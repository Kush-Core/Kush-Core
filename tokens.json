{
  "$comment": "Single source of colour, type and motion tokens for every SVG and the Chronicle renderer. Contrast ratios are WCAG 2.x, text colour on the theme's panel colour, recomputed 2026-11-02.",
  "themes": {
    "dark": {
      "ink":    { "value": "#E6EDF3", "contrast": 16.02, "use": "body text" },
      "gold":   { "value": "#FFC94A", "contrast": 12.35, "use": "name, borders" },
      "rubric": { "value": "#FF4D8D", "contrast": 6.04,  "use": "section titles" },
      "cyan":   { "value": "#22D3EE", "contrast": 10.47, "use": "prompts, links" },
      "muted":  { "value": "#8B949E", "contrast": 6.15,  "use": "dates, captions" },
      "panel":  { "value": "#0D1117", "use": "background" },
      "panel-border": { "value": "#FFC94A", "opacity": 0.4, "width": 1, "use": "1 px border" }
    },
    "light": {
      "ink":    { "value": "#1F2328", "contrast": 15.80, "use": "body text" },
      "gold":   { "value": "#8A5A00", "contrast": 5.93,  "use": "name, borders" },
      "rubric": { "value": "#B4124A", "contrast": 6.72,  "use": "section titles" },
      "cyan":   { "value": "#0B6E8A", "contrast": 5.81,  "use": "prompts, links" },
      "muted":  { "value": "#59636E", "contrast": 6.11,  "use": "dates, captions" },
      "panel":  { "value": "#FFFFFF", "use": "background" },
      "panel-border": { "value": "#D0D7DE", "opacity": 1.0, "width": 1, "use": "1 px border" }
    }
  },
  "fonts": {
    "name": "UnifrakturMaguntia",
    "body": "JetBrains Mono"
  },
  "motion": {
    "flicker": { "period_s": 6, "max_dips_per_period": 2 },
    "cursor_blink": { "min_period_s": 1.2 },
    "reduced_motion_css": "@media (prefers-reduced-motion: reduce) { * { animation: none; } }"
  }
}
